<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CutTheRopeDX.Launcher</RootNamespace>
    <!--
      Distinct from the game's CutTheRope-DX so the two can sit in one directory at build time; the test
      project references both and would otherwise be handed two assemblies of the same name. The shipped
      layout keeps them apart anyway, the launcher at the root and each backend build below it, and
      distribution renames the published apphost to the name players start.
    -->
    <AssemblyName>CutTheRopeDX.Launcher</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <WindowsDistributionIcon>../distribution/icons/CutTheRopeDXIcon.ico</WindowsDistributionIcon>
    <ApplicationIcon Condition="$([MSBuild]::IsOsPlatform('Windows'))">$(WindowsDistributionIcon)</ApplicationIcon>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Company>ZeptoLab</Company>
    <Product>Cut The Rope: DX</Product>
    <Description>Launcher that selects the graphics backend for Cut the Rope: DX.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <!--
    A console window would flash up in front of the game on Windows. Kept as a console app in Debug so
    the probe result and any launch failure are readable.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::IsOsPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CutTheRopeDX.Tests" />
  </ItemGroup>
</Project>
