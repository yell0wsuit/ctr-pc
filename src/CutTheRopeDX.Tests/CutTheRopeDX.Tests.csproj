<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <OutputType>Library</OutputType>

    <!-- Default: build content -->
    <RunMGCB>true</RunMGCB>

    <!-- Auto-disable in CI (GitHub Actions, GitLab, Azure, etc. set CI=true) -->
    <RunMGCB Condition="'$(CI)' == 'true'">false</RunMGCB>
  </PropertyGroup>

  <!--
    Mirrors the constant the game project defines, so a test that depends on which MonoGame is behind it
    can say so at compile time. Deriving that from the framework at run time instead would mean a test
    detecting the absence of the very thing it exists to guard, and passing because of it.
  -->
  <PropertyGroup Condition="'$(GraphicsBackend)' == 'GL'">
    <DefineConstants>$(DefineConstants);MONOGAME_DESKTOPGL</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CutTheRopeDX.Core\CutTheRopeDX.Core.csproj" />
    <ProjectReference Include="..\CutTheRopeDX.Launcher\CutTheRopeDX.Launcher.csproj" />
  </ItemGroup>

  <!--
    The headless tests read the real content tree from their own output directory: maps, locales,
    the pack lists, and images/image_dimensions.json, which only the content build emits. Before the
    src/ split this arrived transitively through a ProjectReference to the game project; referencing
    Core alone leaves the tests with nothing to load, so they import the content build directly.
  -->
  <Import Project="../../content/Builder/BuildContent.targets" />

</Project>
