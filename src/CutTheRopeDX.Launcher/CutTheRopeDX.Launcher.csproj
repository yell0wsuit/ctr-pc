<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>CutTheRopeDX.Launcher</RootNamespace>
    <AssemblyName>CutTheRopeDX.Launcher</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <WindowsDistributionIcon>../../distribution/icons/CutTheRopeDXIcon.ico</WindowsDistributionIcon>
    <ApplicationIcon Condition="$([MSBuild]::IsOsPlatform('Windows'))">$(WindowsDistributionIcon)</ApplicationIcon>
    <VersionPrefix>1.0.0</VersionPrefix>
    <Company>ZeptoLab</Company>
    <Product>Cut The Rope: DX</Product>
    <Description>Launcher that selects the graphics backend for Cut the Rope: DX.</Description>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <!--
    A console window would flash up in front of the game on Windows. Kept as a console app in Debug so
    the probe result and any launch failure are readable.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::IsOsPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CutTheRopeDX.Tests" />
  </ItemGroup>
</Project>
