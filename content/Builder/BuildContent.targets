<Project>
  <PropertyGroup>
    <ContentBuilderProject>$(MSBuildThisFileDirectory)CutTheRopeDX.Content.csproj</ContentBuilderProject>
    <ContentSourceDir>$(MSBuildThisFileDirectory)..</ContentSourceDir>

    <!--
      Content is built for one platform and read by every graphics backend, rather than once per
      backend. Building it per backend would double a build of over a thousand assets, and the audio
      re-encoding in it is the slowest part of the whole build, to produce two trees that differ in a
      single byte: the platform identifier in each XNB header, which MonoGame does not enforce.
    -->
    <ContentPlatform Condition="'$(ContentPlatform)' == ''">DesktopVK</ContentPlatform>

    <ContentBuildOutput>$(MSBuildThisFileDirectory)bin/$(ContentPlatform)/content</ContentBuildOutput>
    <ContentBuildTemp>$(MSBuildThisFileDirectory)obj/$(ContentPlatform)</ContentBuildTemp>
    <CompressContent Condition="'$(CompressContent)' == ''">true</CompressContent>
    <ContentCompressionArgument Condition="'$(CompressContent)' == 'true'">--compress</ContentCompressionArgument>

    <!--
      Whether this build carries a copy of the content to its output. Normally it must: a build has to be
      runnable on its own. The Windows release is the exception, where two backends are published into one
      directory and share a single copy, so the second is told to skip both the content build and the
      deploy. That saves copying roughly 350MB of it twice, once into the build output and again into the
      publish directory, only to delete it while assembling the package.
    -->
    <DeployContent Condition="'$(DeployContent)' == ''">true</DeployContent>
  </PropertyGroup>

  <!--
    The RunMGCB condition sits on the tasks rather than the target so that
    AddBuiltContent's AfterTargets hook fires either way. CI jobs that receive
    prebuilt content leave RunMGCB false and still get it packaged.
  -->
  <Target Name="BuildGameContent"
          BeforeTargets="BeforeBuild">
    <MSBuild Projects="$(ContentBuilderProject)" Targets="Restore"
             Condition="'$(RunMGCB)' == 'true'"
             RemoveProperties="Configuration;TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;MonoGamePlatform;SelfContained;PublishSingleFile" />
    <MSBuild Projects="$(ContentBuilderProject)" Targets="Build"
             Condition="'$(RunMGCB)' == 'true'"
             RemoveProperties="Configuration;TargetFramework;RuntimeIdentifier;RuntimeIdentifiers;MonoGamePlatform;SelfContained;PublishSingleFile" />
    <Exec Condition="'$(RunMGCB)' == 'true'"
          Command="dotnet &quot;$(MSBuildThisFileDirectory)bin/Debug/CutTheRopeDX.Content.dll&quot; fetch -s &quot;$(ContentSourceDir)&quot;" />
    <Exec Condition="'$(RunMGCB)' == 'true'"
          Command="dotnet &quot;$(MSBuildThisFileDirectory)bin/Debug/CutTheRopeDX.Content.dll&quot; build -p $(ContentPlatform) -s &quot;$(ContentSourceDir)&quot; -o &quot;$(ContentBuildOutput)&quot; -i &quot;$(ContentBuildTemp)&quot; $(ContentCompressionArgument)"
          CustomErrorRegularExpression="\[E\] .+" CustomWarningRegularExpression="\[W\] .+" />
  </Target>

  <Target Name="AddBuiltContent" AfterTargets="BuildGameContent"
          Condition="Exists('$(ContentBuildOutput)') AND '$(DeployContent)' == 'true'">
    <ItemGroup>
      <_BuiltContent Include="$(ContentBuildOutput)/**/*" Exclude="$(ContentBuildOutput)/**/.DS_Store" />
      <None Include="@(_BuiltContent)" Condition="'$(TargetFramework)' != 'net10.0-macos'">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <Link>content/%(RecursiveDir)%(Filename)%(Extension)</Link>
      </None>
    </ItemGroup>
  </Target>

  <!--
    macOS: the .app bundle takes the same built content, but as BundleResource.
    _CollectBundleResources runs outside the normal BeforeBuild ordering, so items
    added by AddBuiltContent never reach it. The Apple SDK's documented extension
    point is CollectBundleResourcesDependsOn; the SDK prepends its own targets to
    whatever this property already holds, so setting it here survives.
  -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-macos'">
    <CollectBundleResourcesDependsOn>
      $(CollectBundleResourcesDependsOn);
      AddMacOSBundleContent;
    </CollectBundleResourcesDependsOn>
  </PropertyGroup>

  <Target Name="AddMacOSBundleContent" DependsOnTargets="BuildGameContent"
          Condition="'$(TargetFramework)' == 'net10.0-macos' AND '$(DeployContent)' == 'true'">
    <ItemGroup>
      <_MacBundleContent Include="$(ContentBuildOutput)/**/*" Exclude="$(ContentBuildOutput)/**/.DS_Store" />
      <BundleResource Include="@(_MacBundleContent)">
        <Link>content/%(RecursiveDir)%(Filename)%(Extension)</Link>
      </BundleResource>
    </ItemGroup>
  </Target>
</Project>
