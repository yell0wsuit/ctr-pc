<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <!-- This checks if the project is being built for Windows
  or being tested in Visual Studio on Windows. If it is, it
  switches the build and how it functions to WindowsDX. -->
  <Choose>
    <When Condition="'$(RuntimeIdentifier)' == 'win-x64'">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);MONOGAME_WINDOWSDX</DefineConstants>
      </PropertyGroup>
    </When>
    <When Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == ''">
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);MONOGAME_WINDOWSDX</DefineConstants>
      </PropertyGroup>
    </When>
    <Otherwise>
      <PropertyGroup>
        <DefineConstants>$(DefineConstants);MONOGAME_DESKTOPGL</DefineConstants>
      </PropertyGroup>
    </Otherwise>
  </Choose>
  <PropertyGroup>
    <ProjectGuid>{9A732C70-39B7-456E-8029-91F641C29567}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CutTheRope</RootNamespace>
    <AssemblyName>CutTheRope-DX</AssemblyName>
    <TargetFramework>net9.0</TargetFramework>
    <TargetFramework Condition="$(DefineConstants.Contains('MONOGAME_WINDOWSDX'))">net9.0-windows</TargetFramework>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>CutTheRope.ico</ApplicationIcon>
    <AssemblyVersion>2.4.5.0</AssemblyVersion>
    <FileVersion>2.4.5.0</FileVersion>
    <InformationalVersion>2.4.5.0</InformationalVersion>
    <Company>ZeptoLab</Company>
    <Product>Cut The Rope: DX</Product>
    <Description>Cut the Rope: DX, a fan-made enhancement of the PC version of Cut the Rope.</Description>
    <Copyright>Copyright © 2012</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.5.2" />
    <PackageReference Condition="$(DefineConstants.Contains('MONOGAME_WINDOWSDX'))" Include="MonoGame.Framework.WindowsDX" Version="3.8.4.1" />
    <PackageReference Condition="$(DefineConstants.Contains('MONOGAME_DESKTOPGL'))" Include="MonoGame.Framework.DesktopGL" Version="3.8.4.1" />
    <PackageReference Include="MonoGame.Content.Builder.Task" Version="3.8.4.1" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Microsoft.Xna.Framework.RuntimeProfile" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\content\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>content\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Remove="..\content\content.mgcb" />
    <None Remove="..\content\bin\**\*.*" />
    <None Remove="..\content\obj\**\*.*" />
    <None Remove="..\content\**\*.png" />
    <None Remove="..\content\sounds\sfx\*.wav" />
  </ItemGroup>
  <Choose>
    <When Condition="$(DefineConstants.Contains('MONOGAME_WINDOWSDX'))">
      <ItemGroup>
        <Compile Remove="..\content\sounds\game_music.ogg" />
        <Compile Remove="..\content\sounds\game_music.xnb" />
        <Compile Remove="..\content\sounds\game_music2.ogg" />
        <Compile Remove="..\content\sounds\game_music2.xnb" />
        <Compile Remove="..\content\sounds\game_music3.ogg" />
        <Compile Remove="..\content\sounds\game_music3.xnb" />
        <Compile Remove="..\content\sounds\game_music4.ogg" />
        <Compile Remove="..\content\sounds\game_music4.xnb" />
        <Compile Remove="..\content\sounds\game_music5.ogg" />
        <Compile Remove="..\content\sounds\game_music5.xnb" />
        <Compile Remove="..\content\sounds\game_music_xmas.ogg" />
        <Compile Remove="..\content\sounds\game_music_xmas.xnb" />
        <Compile Remove="..\content\sounds\menu_music.ogg" />
        <Compile Remove="..\content\sounds\menu_music.xnb" />
        <Compile Remove="..\content\sounds\menu_music_xmas.ogg" />
        <Compile Remove="..\content\sounds\menu_music_xmas.xnb" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <Compile Remove="..\content\sounds\game_music_windows.wav" />
        <Compile Remove="..\content\sounds\game_music_windows.xnb" />
        <Compile Remove="..\content\sounds\game_music2_windows.wav" />
        <Compile Remove="..\content\sounds\game_music2_windows.xnb" />
        <Compile Remove="..\content\sounds\game_music3_windows.wav" />
        <Compile Remove="..\content\sounds\game_music3_windows.xnb" />
        <Compile Remove="..\content\sounds\game_music4_windows.wav" />
        <Compile Remove="..\content\sounds\game_music4_windows.xnb" />
        <Compile Remove="..\content\sounds\game_music5_windows.wav" />
        <Compile Remove="..\content\sounds\game_music5_windows.xnb" />
        <Compile Remove="..\content\sounds\game_music_xmas_windows.wav" />
        <Compile Remove="..\content\sounds\game_music_xmas_windows.xnb" />
        <Compile Remove="..\content\sounds\menu_music_windows.wav" />
        <Compile Remove="..\content\sounds\menu_music_windows.xnb" />
        <Compile Remove="..\content\sounds\menu_music_xmas_windows.wav" />
        <Compile Remove="..\content\sounds\menu_music_xmas_windows.xnb" />
      </ItemGroup>
    </Otherwise>
  </Choose>
  <ItemGroup>
    <MonoGameContentReference Include="..\content\content.mgcb" />
  </ItemGroup>
  <Target Name="RestoreDotnetTools" BeforeTargets="CollectPackageReferences">
    <Message Text="Restoring dotnet tools (this might take a while depending on your internet speed and should only happen upon building your project for the first time, or after upgrading MonoGame, or clearing your nuget cache)" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>